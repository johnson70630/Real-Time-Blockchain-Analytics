# Preserve Java 17 explicitly on the cloud-only Python 3.12 / Debian 13 base.
ARG PYTHON_BASE=python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ARG JAVA17_BASE=eclipse-temurin:17-jre-noble@sha256:042c05a77eb915684fc8c92cfbbef4fd6f8c24ca7d934d1a7db3543453aaa077
FROM ${JAVA17_BASE} AS java17
FROM ${PYTHON_BASE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SPARK_LOCAL_IP=127.0.0.1 SPARK_LOCAL_HOSTNAME=localhost \
    JAVA_HOME=/opt/java/openjdk LANG=C.UTF-8 LC_ALL=C.UTF-8 LANGUAGE="" \
    JAVA_TOOL_OPTIONS="-Djava.awt.headless=true"
ENV PATH="${JAVA_HOME}/bin:${PATH}"
# The AWS bundle also contains unshaded Netty classes. Put the reviewed families
# first for both the Python-launched driver and any executor classloader.
ENV PYSPARK_SUBMIT_ARGS="--driver-class-path /opt/pilot/jvm-overrides/* --conf spark.executor.extraClassPath=/opt/pilot/jvm-overrides/* pyspark-shell"
WORKDIR /app
COPY --from=java17 /opt/java/openjdk /opt/java/openjdk
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libstdc++6 zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && java -version 2>&1 | grep '^openjdk version "17\.'
COPY deploy/runtime/spark-requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
    && useradd --uid 10001 --create-home pilot
COPY deploy/runtime/jars.lock.json /tmp/jars.lock.json
COPY deploy/runtime/fetch_jars.py /tmp/fetch_jars.py
COPY deploy/runtime/spark-jvm-patches.lock.json /tmp/spark-jvm-patches.lock.json
COPY deploy/runtime/patch_jars.py /tmp/patch_jars.py
RUN --mount=type=bind,source=deploy/runtime/verified-jars,target=/tmp/verified-jars,ro \
    python /tmp/fetch_jars.py /tmp/jars.lock.json --cache-only /tmp/reviewed-jars --cache /tmp/verified-jars --offline \
    && python /tmp/patch_jars.py /tmp/spark-jvm-patches.lock.json --cache /tmp/reviewed-jars --overrides /opt/pilot/jvm-overrides \
    && python /tmp/fetch_jars.py /tmp/jars.lock.json --cache /tmp/reviewed-jars --offline \
    && rm -rf /tmp/reviewed-jars
COPY config /app/config
COPY spark /app/spark
COPY runtime /app/runtime
USER 10001:10001
# No Maven resolver or package download is invoked at runtime.
CMD ["python", "-m", "runtime.stream"]
