# Cloud-only Python 3.12 / Debian 13; the digest is reviewed in images.lock.json.
ARG PYTHON_BASE=python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${PYTHON_BASE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LANG=C.UTF-8 LC_ALL=C.UTF-8 LANGUAGE=""
WORKDIR /app
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/runtime/producer-requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
    && useradd --uid 10001 --create-home pilot
COPY config /app/config
COPY producer /app/producer
COPY runtime /app/runtime
# This non-root worker needs no setuid/setgid account or mount helpers.
# Keep package files/metadata intact; clear only their privilege bits.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s -- {} +
USER 10001:10001
CMD ["python", "-m", "runtime.producer"]
