{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": "s3:GetBucketLocation",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::johnson-blockchain-analytics-prod",
      "Sid": "GetPilotBucketLocation"
    },
    {
      "Action": "s3:ListBucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "blockchain-analytics/pilot/runtime/11-6c-v1",
            "blockchain-analytics/pilot/runtime/11-6c-v1/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::johnson-blockchain-analytics-prod",
      "Sid": "ListOnlyPilotData"
    },
    {
      "Action": "s3:ListBucketMultipartUploads",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::johnson-blockchain-analytics-prod",
      "Sid": "ListPilotMultipartUploads"
    },
    {
      "Action": [
        "s3:PutObject",
        "s3:ListMultipartUploadParts",
        "s3:GetObjectVersion",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::johnson-blockchain-analytics-prod/blockchain-analytics/pilot/runtime/11-6c-v1/*",
      "Sid": "ReadWriteOnlyPilotData"
    },
    {
      "Action": [
        "s3:ListBucketVersions",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::blockchain-analytics-terraform-state-209479274979-usw2",
      "Sid": "DenyTerraformStateBucketMetadata"
    },
    {
      "Action": [
        "s3:PutObject",
        "s3:GetObjectVersion",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::blockchain-analytics-terraform-state-209479274979-usw2/*",
      "Sid": "DenyTerraformStateObjects"
    },
    {
      "Action": "ecr:GetAuthorizationToken",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "GetEcrAuthorizationToken"
    },
    {
      "Action": [
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ecr:us-west-2:209479274979:repository/blockchain-runtime-spark",
        "arn:aws:ecr:us-west-2:209479274979:repository/blockchain-runtime-producer"
      ],
      "Sid": "PullApprovedRuntimeImages"
    },
    {
      "Action": [
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "logs:CreateLogStream"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:logs:us-west-2:209479274979:log-group:/blockchain/runtime/containers:*",
      "Sid": "WriteRuntimeLogs"
    },
    {
      "Sid": "ReadApprovedRuntimeSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-west-2:209479274979:secret:blockchain-runtime/11-6c/alchemy-websocket-url-d44flr"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}
