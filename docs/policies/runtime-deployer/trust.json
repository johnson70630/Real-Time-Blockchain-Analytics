{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyPlanningUserWithMfa",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::209479274979:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::209479274979:user/blockchain-de-local"
        },
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
