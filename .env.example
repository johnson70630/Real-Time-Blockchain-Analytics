# ============================
# Alchemy
# ============================

ALCHEMY_WEBSOCKET_URL=wss://arb-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>
ALCHEMY_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>

# ============================
# Kafka
# ============================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Producer (existing)
KAFKA_TOPIC=uniswap_v3_swaps
MARKET_DATA_KAFKA_TOPIC=market_data_observations
PROTOCOL=uniswap_v3

# ============================
# Market Data Poller (new)
# ============================

CHAINLINK_POLL_INTERVAL_SECONDS=30
CHAINLINK_FEEDS_CONFIG=config/chainlink_feeds.json
