# ============================
# Alchemy
# ============================

ALCHEMY_WEBSOCKET_URL=wss://arb-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>
ALCHEMY_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>
# Dedicated bounded Aave bootstrap/recovery endpoint; never used for streaming.
AAVE_BACKFILL_RPC_URL=
# Provider-neutral bounded recovery endpoint; never used for live streaming.
BLOCKCHAIN_RECOVERY_RPC_URL=

# ============================
# Kafka
# ============================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Producer (existing)
KAFKA_TOPIC=uniswap_v3_swaps
MARKET_DATA_KAFKA_TOPIC=market_data_observations
PROTOCOL=uniswap_v3
ENABLED_PROTOCOLS=uniswap_v3,aave_v3

# Public Aave V3 Pool deployment address for Arbitrum.
AAVE_V3_POOL_ADDRESS=0x794a61358D6845594F94dc1DB02A252b5b4814aD
# Supported project analytics begin at the first block at/after this UTC time.
AAVE_PROJECT_COLLECTION_START_AT=2026-10-01T00:00:00Z
# RPC-verified first Arbitrum block at the configured collection timestamp.
AAVE_PROJECT_COLLECTION_START_BLOCK=510496864
# Operational safety lag only; this is not a protocol-finality guarantee.
AAVE_CONFIRMATION_DEPTH=1200
# Ankr-calibrated bounded parent range and adaptive fallback policy.
AAVE_BOOTSTRAP_CHUNK_SIZE=3000
AAVE_BOOTSTRAP_MIN_RANGE_SIZE=100
AAVE_BOOTSTRAP_MAX_RANGE_SIZE=3000
AAVE_BOOTSTRAP_MAX_RANGE_ATTEMPTS=64
# Finite operational cap for one normal forward catch-up execution.
AAVE_FORWARD_MAX_BLOCKS_PER_RUN=600000

# Public Uniswap V3 deployment configuration for Arbitrum.
UNISWAP_V3_FACTORY_ADDRESS=0x1F98431c8aD98523631AE4a59f267346ea31F984
UNISWAP_V3_FACTORY_START_BLOCK=165
# Shared project analytics boundary and bounded source-recovery policy.
UNISWAP_PROJECT_COLLECTION_START_BLOCK=510496864
UNISWAP_CONFIRMATION_DEPTH=1200
UNISWAP_RECOVERY_CHUNK_SIZE=5000
UNISWAP_RECOVERY_ADDRESS_BATCH_SIZE=68
UNISWAP_RECOVERY_MIN_RANGE_SIZE=1000
UNISWAP_RECOVERY_MAX_RANGE_ATTEMPTS=64
UNISWAP_FORWARD_MAX_BLOCKS_PER_RUN=600000

# ============================
# Market Data Poller (new)
# ============================

CHAINLINK_POLL_INTERVAL_SECONDS=30
CHAINLINK_FEEDS_CONFIG=config/chainlink_feeds.json
# Independent operational lag for one consistent multi-feed snapshot.
CHAINLINK_CONFIRMATION_DEPTH=1200
# RPC-verified first Arbitrum block in the supported historical price period.
CHAINLINK_PROJECT_COLLECTION_START_BLOCK=510496864
# Finite cap across all missing feed rounds in one forward execution.
CHAINLINK_FORWARD_MAX_ROUNDS_PER_RUN=10000

# ============================
# Silver Price Enrichment
# ============================

MAX_PRICE_AGE_SECONDS=300
ASSET_PRICE_MAPPING_CONFIG=config/asset_price_mapping.json

# ============================
# Durable Storage
# ============================

# Keep "local" for the default developer workflow. Use "s3" in cloud jobs.
STORAGE_MODE=local
DATA_LAKE_BUCKET=
DATA_LAKE_PREFIX=blockchain-analytics
AWS_REGION=us-west-2
# Optional local AWS shared-config profile name; never put credentials here.
AWS_PROFILE=
SPARK_S3_CONNECTOR_PACKAGE=org.apache.hadoop:hadoop-aws:3.4.1

# ============================
# Snowflake RAW Landing
# ============================

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_DATABASE=BLOCKCHAIN_ANALYTICS
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_CONTROL_SCHEMA=CONTROL
SNOWFLAKE_WATERMARK_TABLE=PIPELINE_WATERMARKS
SNOWFLAKE_COMPLETED_RANGES_TABLE=PIPELINE_COMPLETED_RANGES
SNOWFLAKE_RUN_LEASES_TABLE=PIPELINE_RUN_LEASES
SNOWFLAKE_PIPELINE_RUNS_TABLE=PIPELINE_RUNS
SNOWFLAKE_STAGE=SILVER_S3_STAGE
SNOWFLAKE_FILE_FORMAT=PARQUET_FORMAT

# ============================
# DeFi Data Lab (read only)
# ============================

# Explicitly selects the local named-connection path. Streamlit Cloud uses
# DATA_LAB_ENV=hosted through its root-level Secrets configuration.
DATA_LAB_ENV=local
# Reuses the key-pair credentials in the named Snowflake connection.
SNOWFLAKE_APP_CONNECTION_NAME=blockchain-dev
SNOWFLAKE_APP_ROLE=BLOCKCHAIN_ANALYST_ROLE
SNOWFLAKE_APP_WAREHOUSE=BLOCKCHAIN_TRANSFORM_WH
SNOWFLAKE_APP_DATABASE=BLOCKCHAIN_ANALYTICS
SNOWFLAKE_APP_SCHEMA=MARTS
